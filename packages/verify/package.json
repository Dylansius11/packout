{
  "name": "@packout/verify",
  "version": "0.1.0",
  "type": "module",
  "description": "Independent PACKOUT bundle v1 verifier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dylansius11/packout",
    "directory": "packages/verify"
  },
  "keywords": [
    "packout",
    "portaldot",
    "bundle",
    "verification",
    "cli"
  ],
  "bin": {
    "packout-verify": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@polkadot/api": "17.0.2",
    "viem": "2.57.10",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@packout/sdk": "workspace:*",
    "@types/ws": "8.18.2"
  }
}
