{
  "name": "@packout/verify",
  "version": "0.0.0",
  "type": "module",
  "description": "Independent PACKOUT bundle v1 verifier",
  "bin": {
    "packout-verify": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@polkadot/api": "17.0.2",
    "viem": "2.57.10",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@packout/sdk": "workspace:*",
    "@types/ws": "8.18.2"
  }
}
