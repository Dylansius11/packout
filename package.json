{
  "name": "packout",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:contracts": "pnpm --filter @packout/contracts test",
    "demo:checkin": "pnpm --filter @packout/scripts demo:checkin",
    "demo:local": "pnpm --filter @packout/scripts demo:local",
    "demo:full": "pnpm --filter @packout/scripts demo:full",
    "demo:full:local": "pnpm --filter @packout/scripts demo:full:local",
    "vendor-api": "pnpm --filter @packout/vendor-api start",
    "vendor-a": "pnpm --filter @packout/vendor-a dev",
    "client-b": "pnpm --filter @packout/client-b dev",
    "e2e": "pnpm --filter @packout/e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
