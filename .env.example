# Deployer key for explicitly requested testnet transactions; never commit a real key.
DEPLOYER_PRIVATE_KEY=
# Vendor writer key for anchoring operations; never commit a real key.
VENDOR_WRITER_PRIVATE_KEY=
# Public Portaldot testnet EVM RPC endpoint.
PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
# F9 Succession: sr25519 mnemonic of the dedicated workspace-authority account W (testnet only).
SUCCESSION_W_MNEMONIC=
